{
  "name": "TechHome",
  "version": "1.0.0",
  "description": "This is TechHome project backend",
  "main": "src/server.ts",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "start": "ts-node src/server.ts",
    "start:dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "train": "nodemon --exec python3 train.py",
    "train:ts": "nodemon --exec ts-node src/train.ts",
    "test": "npm run build && node --test test/*.test.cjs test/*.integration.cjs",
    "bootstrap:store": "ts-node src/scripts/bootstrap-store.ts",
    "test:unit": "npm run build && node --test test/*.test.cjs",
    "test:integration": "npm run build && node --test --test-concurrency=1 test/*.integration.cjs"
  },
  "author": "MIT",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "connect-mongodb-session": "3.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "ejs": "3.1.10",
    "express": "4.22.3",
    "express-rate-limit": "8.7.2",
    "express-session": "1.19.0",
    "jsonwebtoken": "9.0.3",
    "moment": "2.31.0",
    "mongoose": "6.13.12",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "sharp": "0.35.5",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/connect-mongodb-session": "^2.4.7",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.3",
    "@types/express-session": "^1.17.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "2.3.0",
    "mongodb-memory-server-core": "10.4.3",
    "nodemon": "^3.0.2",
    "supertest": "7.3.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
