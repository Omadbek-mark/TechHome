# Development only. Use one hostname consistently in frontend and API URLs.
NODE_ENV=development
PORT=3002
MONGO_URL=mongodb://127.0.0.1:27017/techhome_dev
WEB_ORIGINS=http://127.0.0.1:3000
API_ORIGIN=http://127.0.0.1:3002
TRUST_PROXY_HOPS=0
UPLOADS_ROOT=./uploads
# Required: independently generated random secrets, at least 32 characters each.
SESSION_SECRET=
SECRET_TOKEN=
# Only for the explicitly confirmed bootstrap:store command; never logged.
BOOTSTRAP_NICK=
BOOTSTRAP_PHONE=
BOOTSTRAP_PASSWORD=

# AI stays off until a server-only key/model are configured. Never put these in VITE_*.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=768
AI_GUEST_DAILY_LIMIT=10
AI_MEMBER_DAILY_LIMIT=30
AI_PROVIDER_DAILY_LIMIT=100
